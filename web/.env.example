# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings > Environment Variables (Production and Preview).

# Base URL of the Mitra API (the FastAPI service in ../mitra). Server-side only: no NEXT_PUBLIC_ prefix,
# so it is never sent to the browser.
#   local:  http://127.0.0.1:8765   (run: python -m mitra serve --port 8765 from the repo root)
#   Vercel: injected by a service binding if the API is a second service in the same project,
#           otherwise the API project's URL.
MITRA_API_URL=

# One of the keys in the API's MITRA_API_KEYS. Required when the API runs with MITRA_ENV=production.
# Server-side only. Rotate it by adding the new key to MITRA_API_KEYS, switching this value, then
# removing the old key.
MITRA_API_KEY=
